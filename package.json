{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/validate-build.mjs && nuxt build",
    "build:demo": "node scripts/validate-build.mjs --demo && nuxt build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:data": "node --test tests/data.test.ts",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:config": "node --test tests/build-config.test.mjs",
    "test": "npm run test:data && npm run test:config && npm run test:unit",
    "test:e2e": "playwright test",
    "test:live-auth": "node tests/live-auth.mjs",
    "format": "prettier --write app tests nuxt.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check app tests nuxt.config.ts vitest.config.ts playwright.config.ts",
    "check": "npm run format:check && npm run check:structure && npm run typecheck && npm test && npm run build:demo && npm run check:bundle"
  },
  "dependencies": {
    "@fontsource-variable/kantumruy-pro": "5.3.0",
    "@pinia/nuxt": "1.0.3",
    "@primeuix/themes": "2.0.3",
    "@tanstack/vue-query": "5.104.5",
    "@vue/devtools-api": "8.2.1",
    "date-fns": "4.4.0",
    "nuxt": "^4.6.1",
    "pinia": "4.1.0",
    "primeicons": "8.0.2",
    "primevue": "4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24 <27"
  }
}

# Local simulation is the default. Restart the Nuxt process after changing mode.
NUXT_PUBLIC_DATA_SOURCE=local
NUXT_PUBLIC_API_BASE_URL=
# Remote example (API must implement the agreed contract):
# NUXT_PUBLIC_DATA_SOURCE=remote
# NUXT_PUBLIC_API_BASE_URL=https://hr.example.com/api/v1

# Non-secret CSRF cookie set by your same-origin identity host before sign-in.
NUXT_PUBLIC_CSRF_COOKIE_NAME=XSRF-TOKEN
